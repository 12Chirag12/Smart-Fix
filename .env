# ==============================================================================
# SmartFix AI — Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & Local LLM Engine Settings (Ollama)
# ------------------------------------------------------------------------------
# AI Provider (default: ollama)
SMARTFIX_AI_PROVIDER=ollama

# Local LLM model for unknown crash analysis & PowerShell fix generation.
# Active local model: qwen3:4b-instruct (2.5 GB, high-accuracy PowerShell code generation)
SMARTFIX_AI_MODEL=qwen3:4b-instruct

# Local Ollama service endpoints
SMARTFIX_OLLAMA_URL=http://localhost:11434/api/generate
SMARTFIX_OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. College Computer Lab Monitor & Multi-PC LAN Repair Settings
# ------------------------------------------------------------------------------
# TCP Port used for remote diagnostic polling & authenticated repair commands
SMARTFIX_LAB_PORT=7771

# UDP Broadcast Port for LAN workstation discovery (Auto-discovering student PCs)
SMARTFIX_DISCOVERY_PORT=7772

# Default Admin Passkey for Central Controller authentication and remote repairs
SMARTFIX_ADMIN_PASSKEY=admin123

# Workstation seat prefix (PC-<HOSTNAME>)
SMARTFIX_SEAT_PREFIX=PC

# ------------------------------------------------------------------------------
# 3. Background Monitoring & Logging Settings
# ------------------------------------------------------------------------------
# Polling interval in seconds for background hardware & event-log monitoring
SMARTFIX_MONITOR_INTERVAL=5

# Application logging level (DEBUG, INFO, WARNING, ERROR)
SMARTFIX_LOG_LEVEL=INFO

# Set to 1 to run in developer mode without requiring admin elevation prompt
SMARTFIX_DEV=0


# ==============================================================================
# Legacy Prototype Configuration (Archived)
# ==============================================================================
